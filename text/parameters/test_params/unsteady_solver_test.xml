<?xml version="1.0" encoding="UTF-8"?>
<ParameterHandler>
    <Coefficients>
        <Kinematic_20Viscosity>
            <value>1</value>
            <default_value>1.0</default_value>
            <documentation>The Kinematic Viscosity Coefficient (nu)</documentation>
            <pattern>6</pattern>
            <pattern_description>[Double 1e-16...MAX_DOUBLE (inclusive)]</pattern_description>
        </Kinematic_20Viscosity>
        <Sigma>
            <value>0</value>
            <default_value>0.0</default_value>
            <documentation>The coefficient sigma</documentation>
            <pattern>7</pattern>
            <pattern_description>[Double 0...MAX_DOUBLE (inclusive)]</pattern_description>
        </Sigma>
    </Coefficients>
    <Files>
        <Mesh_20file>
            <value>./text/meshes/mesh-pipe.msh</value>
            <default_value>./mesh.vtk</default_value>
            <documentation>A .vtk file containing a mesh</documentation>
            <pattern>2</pattern>
            <pattern_description>[FileName (Type: input)]</pattern_description>
        </Mesh_20file>
        <Output_20file>
            <value>./text/outputs/us_pipe.pvtu</value>
            <default_value>./output.vtk</default_value>
            <documentation>A .vtk file to save the solution to</documentation>
            <pattern>3</pattern>
            <pattern_description>[FileName (Type: output)]</pattern_description>
        </Output_20file>
    </Files>
    <Finite_20Elements>
        <Polynomial_20degree_20pressure>
            <value>1</value>
            <default_value>1</default_value>
            <documentation>The polynomial degree of the Elements of the pressure</documentation>
            <pattern>5</pattern>
            <pattern_description>[Integer range 1...7 (inclusive)]</pattern_description>
        </Polynomial_20degree_20pressure>
        <Polynomial_20degree_20velocity>
            <value>1</value>
            <default_value>2</default_value>
            <documentation>The polynomial degree of the Elements of the velocity</documentation>
            <pattern>4</pattern>
            <pattern_description>[Integer range 1...7 (inclusive)]</pattern_description>
        </Polynomial_20degree_20velocity>
    </Finite_20Elements>
    <Solver>
        <Max_20iters>
            <value>1000</value>
            <default_value>1000</default_value>
            <documentation>Max number of iters for linear solver</documentation>
            <pattern>0</pattern>
            <pattern_description>[Integer range 1...100000 (inclusive)]</pattern_description>
        </Max_20iters>
        <Tolerance>
            <value>1e-10</value>
            <default_value>1e-10</default_value>
            <documentation>Tolerance for the linear solver</documentation>
            <pattern>1</pattern>
            <pattern_description>[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]</pattern_description>
        </Tolerance>
    </Solver>
    <Time_20Parameters>
        <Final_20time>
            <value>1</value>
            <default_value>1.0</default_value>
            <documentation>The T st the pde has domain Omega times (0,T)</documentation>
            <pattern>8</pattern>
            <pattern_description>[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]</pattern_description>
        </Final_20time>
        <Theta>
            <value>1</value>
            <default_value>0.5</default_value>
            <documentation>The theta parameter for the theta method</documentation>
            <pattern>10</pattern>
            <pattern_description>[Double 0...1 (inclusive)]</pattern_description>
        </Theta>
        <Time_20step>
            <value>0.025</value>
            <default_value>0.05</default_value>
            <documentation>The time step dt to use for the theta method</documentation>
            <pattern>9</pattern>
            <pattern_description>[Double -MAX_DOUBLE...MAX_DOUBLE (inclusive)]</pattern_description>
        </Time_20step>
    </Time_20Parameters>
</ParameterHandler>
